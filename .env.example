# Copia questi valori nelle Environment Variables di Netlify
# (Site configuration → Environment variables). In locale: crea un file .env
# oppure passa le variabili al comando, es. RESEND_API_KEY=... npm run dev

# --- Firebase: dove vengono salvate le prenotazioni ---
# JSON del service account, tutto su una riga.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --- Dashboard /admin ---
ADMIN_USER=admin
ADMIN_PASS=cambia-questa-password

# --- Notifica delle prenotazioni via Resend (https://resend.com) ---
# Ad ogni prenotazione parte una sola email: la notifica a BOOKING_TO.
# La conferma al cliente la manda a mano chi gestisce le prenotazioni,
# rispondendo alla notifica (il reply-to è già impostato sul cliente).
# Senza RESEND_API_KEY le prenotazioni si salvano comunque, ma non arriva nessuna email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
BOOKING_TO=matas300@gmail.com

# --- Opzionali: conferma automatica al cliente ---
# Richiede un dominio verificato su resend.com. Senza dominio verificato Resend
# accetta invii SOLO verso l'indirizzo del proprietario dell'account, quindi la
# conferma ai clienti verrebbe rifiutata.
# Quando il dominio è verificato: imposta il mittente e metti il flag a 'true'.
# BOOKING_FROM=Bolo Crawl <prenotazioni@tuodominio.it>
# BOOKING_CONFIRM_CUSTOMER=true
